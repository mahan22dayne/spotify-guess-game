# این فایل کاملاً اختیاریه. برنامه بدون آن هم کار می‌کند (از طریق خواندن صفحه‌ی
# عمومی پلی‌لیست اسپاتیفای + جستجوی Deezer، یا لینک مستقیم پلی‌لیست Deezer).
# فقط اگر بعداً خواستی مسیر رسمی API اسپاتیفای را هم فعال کنی (نیاز به اکانت
# پریمیوم روی اکانتِ صاحبِ اپ دارد)، این فایل را کپی کن به .env و مقادیر را پر کن.
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
PORT=3000
